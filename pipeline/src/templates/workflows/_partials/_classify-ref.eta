      - name: Checkout
        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
        with:
          fetch-depth: 0

      - name: Set up Node.js
        uses: actions/setup-node@820762786026740c76f36085b0efc47a31fe5020 # v7.0.0
        with:
          node-version: "22"
          cache: npm
          cache-dependency-path: .kerndx-pipeline/pipeline/package-lock.json

      - name: Install KernDX pipeline deps
        working-directory: .kerndx-pipeline/pipeline
        run: npm ci --omit=dev

      - name: Classify head ref
        id: classify
        env:
          HEAD_REF: ${{ github.head_ref }}
        run: |
          node .kerndx-pipeline/bin/kerndx classify-ref \
            --head-ref "$HEAD_REF" \
            --config .kerndx/config.yml \
            >> "$GITHUB_OUTPUT"
