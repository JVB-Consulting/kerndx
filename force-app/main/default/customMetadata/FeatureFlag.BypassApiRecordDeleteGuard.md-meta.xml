<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Bypass API Record Delete Guard</label>
    <protected>false</protected>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">Decides who may delete API calls and API issues. A built-in rule turns it on for Delete API Records holders. To widen it in your org, add a strategy for a profile, permission set or user, or check Result On No Match. Deactivated, it refuses every delete.</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>IsEnabledByDefault__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
    <values>
        <field>ResultOnNoMatch__c</field>
        <value xsi:type="xsd:boolean">false</value>
    </values>
</CustomMetadata>
