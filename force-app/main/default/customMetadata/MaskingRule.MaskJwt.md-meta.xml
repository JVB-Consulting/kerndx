<?xml version="1.0" encoding="UTF-8"?>
<CustomMetadata xmlns="http://soap.sforce.com/2006/04/metadata" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:xsd="http://www.w3.org/2001/XMLSchema">
    <label>Mask JSON Web Tokens</label>
    <protected>false</protected>
    <values>
        <field>ApplicableFieldTypes__c</field>
        <value xsi:nil="true"/>
    </values>
    <values>
        <field>CaseSensitive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>Category__c</field>
        <value xsi:type="xsd:string">Credentials</value>
    </values>
    <values>
        <field>Description__c</field>
        <value xsi:type="xsd:string">Redacts JSON Web Tokens: a token that starts with eyJ and has three dot-separated parts. Values under 20 characters are not checked. Part limits: header 4,000, payload 16,000, signature 2,000 characters. A token with a longer part is left alone.</value>
    </values>
    <values>
        <field>FailureAction__c</field>
        <value xsi:type="xsd:string">WriteFailureMarker</value>
    </values>
    <values>
        <field>IsActive__c</field>
        <value xsi:type="xsd:boolean">true</value>
    </values>
    <values>
        <field>MinInputLength__c</field>
        <value xsi:type="xsd:double">20.0</value>
    </values>
    <values>
        <field>Mode__c</field>
        <value xsi:type="xsd:string">Regex</value>
    </values>
    <values>
        <field>Order__c</field>
        <value xsi:type="xsd:double">300.0</value>
    </values>
    <values>
        <field>Pattern__c</field>
        <value xsi:type="xsd:string">(?&lt;![A-Za-z0-9_-])eyJ[A-Za-z0-9_-]{2,4000}+\.eyJ[A-Za-z0-9_-]{2,16000}+\.[A-Za-z0-9_-]{1,2000}+(?![A-Za-z0-9_-])</value>
    </values>
    <values>
        <field>Replacement__c</field>
        <value xsi:type="xsd:string">[JWT_REDACTED]</value>
    </values>
    <values>
        <field>ReplacesFingerprint__c</field>
        <value xsi:nil="true"/>
    </values>
    <values>
        <field>Replaces__c</field>
        <value xsi:nil="true"/>
    </values>
    <values>
        <field>ShippedFingerprint__c</field>
        <value xsi:nil="true"/>
    </values>
</CustomMetadata>
