<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Status__c</fullName>
    <description>Current processing status: Queued (awaiting), Processing (in progress), Completed (success), Failed (error, no further retry), Retry (scheduled for an automatic retry at Next Retry), Retrying (the retry is running), Batched (batch processing), or Aborted (the call never left your org).</description>
    <inlineHelpText>Queued = awaiting processing. Processing = in progress. Batched = waiting for the scheduled batched-callouts job to queue it. Completed = success. Failed = error, no further retry. Retry = scheduled for an automatic retry at Next Retry. Retrying = the retry is running. Aborted = the call never left your org.</inlineHelpText>
    <label>Status</label>
    <required>false</required>
